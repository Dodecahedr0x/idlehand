# Idlehand web service — copy to .env (or export) before `bun run dev`.

# Port and public URL. BASE_URL is used for OAuth callbacks and the CLI approval link.
# On Render, PORT is injected and BASE_URL is the service's https URL.
PORT=8787
BASE_URL=http://localhost:8787

# GitHub OAuth App (https://github.com/settings/developers -> "New OAuth App"):
#   Homepage URL:               ${BASE_URL}
#   Authorization callback URL: ${BASE_URL}/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Scopes requested. `read:user` lists public repos only. Add `repo` to list the
# user's private repos too (heavier permission; the server never writes to GitHub).
GITHUB_OAUTH_SCOPES=read:user

# Random secret for signing session cookies. Required when BASE_URL is https or
# NODE_ENV=production; generated per-process otherwise. e.g. `openssl rand -hex 32`
SESSION_SECRET=

# SQLite database file.
DB_PATH=./idlehand.sqlite

# Dev only: set to 1 to enable GET /auth/dev?login=<github-login>, which signs in
# without GitHub OAuth so the UI can be exercised locally. Never enable in production.
IDLEHAND_DEV_LOGIN=0
# Comma-separated owner/name repos selected for every dev login. `idlehand dev` sets this
# from the checkout's GitHub origin.
IDLEHAND_DEV_REPO=
